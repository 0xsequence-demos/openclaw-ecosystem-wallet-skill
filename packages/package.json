{
  "name": "polygon-agent-wallet",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "pnpm build && pnpm --filter @polygon-agent/worker dev",
    "dev:ui": "pnpm --filter @polygon-agent/shared build && pnpm --filter @polygon-agent/ui dev",
    "dev:worker": "pnpm --filter @polygon-agent/shared build && pnpm --filter @polygon-agent/ui build && pnpm --filter @polygon-agent/worker dev",
    "test:relay": "pnpm --filter @polygon-agent/shared build && node test/relay-integration.mjs"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0"
}
