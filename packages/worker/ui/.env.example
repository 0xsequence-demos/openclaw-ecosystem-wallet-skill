# Polygon Agent SPA — Environment Variables (Vite, baked at build time)
# Copy to .env for local dev. For production, use .env.production instead.

# Ecosystem Wallet URL
VITE_WALLET_URL=https://wallet.polygon.technology

# Sequence project access key
VITE_PROJECT_ACCESS_KEY=

# DApp origin — leave empty for local dev (defaults to window.location.origin)
# VITE_DAPP_ORIGIN=

# Optional overrides
# VITE_RELAYER_URL=
# VITE_NODES_URL=https://nodes.sequence.app
