# Polygon Agent — SPA Environment Variables
# Copy to .env and fill in values

# Ecosystem Wallet URL (defaults to https://wallet.polygon.technology)
VITE_WALLET_URL=https://wallet.polygon.technology

# Sequence project access key (public, embedded in SPA bundle)
VITE_PROJECT_ACCESS_KEY=

# DApp origin — must match the deployed Worker domain
# For local dev, leave empty (defaults to window.location.origin)
VITE_DAPP_ORIGIN=

# Optional overrides
# VITE_RELAYER_URL=
# VITE_NODES_URL=https://nodes.sequence.app
# VITE_INDEXER_ACCESS_KEY=
