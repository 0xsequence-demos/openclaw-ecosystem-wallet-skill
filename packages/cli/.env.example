# Polygon Agent CLI — Environment Variables
# Copy to .env and fill in values

# Relay URL (defaults to https://relay.polygon.agent.xyz)
# For local dev, set to your local worker:
POLYGON_AGENT_RELAY_URL=http://localhost:8787

# Sequence indexer access key (for balance queries)
SEQUENCE_INDEXER_ACCESS_KEY=

# Optional: custom indexer endpoint
# SEQUENCE_INDEXER_URL=https://indexer.sequence.app/rpc/Indexer/GetTokenBalancesSummary
