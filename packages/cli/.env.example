# Polygon Agent CLI — Environment Variables
# Copy to .env and fill in values

# Relay URL (defaults to https://polygon-agent-relay.0xsequence.workers.dev)
# For local dev, set to your local worker:
POLYGON_AGENT_RELAY_URL=http://localhost:8787

# Sequence project access key (for balances + transaction sending)
SEQUENCE_PROJECT_ACCESS_KEY=
