# Copy to .env and fill values

# Ecosystem connector UI base URL (Cloudflare Worker you deployed)
SEQUENCE_ECOSYSTEM_CONNECTOR_URL=https://moltbot-ecosystem-wallet.<your-subdomain>.workers.dev

# Required for relayer/nodes access (Sequence project access key)
SEQUENCE_PROJECT_ACCESS_KEY=

# Required for balances (Polygon)
SEQUENCE_INDEXER_ACCESS_KEY=

# Optional override
# SEQUENCE_INDEXER_URL=https://polygon-indexer.sequence.app/rpc/Indexer/GetTokenBalancesSummary
